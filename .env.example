# Variables de realtime-gateway con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.
# Este servicio no tiene base de datos (solo Redis).

# --- Servicio ---
SERVER_PORT=18007

# --- Redis compartido, con contraseña (en Docker: redis:6379) ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Otros servicios (en Docker el compose los cambia a host.docker.internal) ---
IDENTITY_JWKS_URI=http://localhost:18001/.well-known/jwks.json
SEAT_INVENTORY_URL=http://localhost:18003
FLASH_OFFERS_URL=http://localhost:18006
FLEET_URL=http://localhost:18005

# --- Navegador: URL pública del API Gateway (página de demostración) y orígenes permitidos del WebSocket ---
PUBLIC_API_URL=http://localhost:18000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18007
# ?token=JWT en la URL de /ws: true en QA mientras el frontend migra al mensaje connect (PROD: false).
WS_ALLOW_QUERY_TOKEN=true

# --- Observabilidad (opcionales) ---
# Colector OTLP/HTTP (p. ej. http://otel-collector:4318). Vacío = no se exportan trazas.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Fracción de trazas que se muestrean (0.1 = 10 %).
TRACING_SAMPLING=0.1
# json = logs ECS en la consola (PROD lo trae por defecto); text = legibles.
LOG_FORMAT=text

# --- Límites (opcionales) ---
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTIONS_PER_USER=5
# Header con la IP real del cliente que pone el API Gateway (vacío = la IP de la conexión TCP).
WS_CLIENT_IP_HEADER=

# --- Web Push (opcionales: sin las tres llaves el push queda apagado) ---
# Generarlas una vez, p. ej.: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tripbus.co
